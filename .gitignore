build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
.env

# Streamlit secrets & config
.streamlit/secrets.toml

# Logs
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

